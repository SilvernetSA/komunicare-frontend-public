    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "start": "vite",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write \"{src,scripts}/**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "core-js-pure",
      "esbuild",
      "husky",
      "swiper"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all",
    "Chrome >= 54",
    "Firefox >= 47",
    "Safari >= 10.1",
    "Edge >= 14"
  ]
}
